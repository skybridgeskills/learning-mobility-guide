# LER Ecosystem Test Suite - Environment Variables
#
# Copy this file to .env.local and fill in values for your environment.
# .env.local is gitignored and will not be committed.

# --- Implementation Secrets ---
# Used in implementation JSON configs via variable reference.
# Example: if an implementation JSON has "keySeed": "KEY_SEED_EXAMPLE",
# the test suite resolves it from this env var.
# KEY_SEED_EXAMPLE=your-key-seed-here
# CLIENT_SECRET_EXAMPLE=your-oauth-client-secret-here

# --- Local Development ---
# Override endpoints for local testing.
# These are used by localConfig.cjs to define localhost implementations.
# LOCAL_ISSUER_ENDPOINT=http://localhost:4004
# LOCAL_VERIFIER_ENDPOINT=http://localhost:4004
# LOCAL_WORKFLOW_ID_ISSUE=issue-badge
# LOCAL_WORKFLOW_ID_VERIFY=verify-badge
